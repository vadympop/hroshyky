# Copy to .env (git-ignored) and fill in. Never commit .env.
# The variable names below are fixed by the spec. The agent adds new variables here with a description.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user IDs allowed to use the bot, comma-separated (get yours from @userinfobot)
TELEGRAM_ALLOWED_USER_IDS=

# LLM provider key — optional, leave empty to run without LLM features
LLM_API_KEY=
